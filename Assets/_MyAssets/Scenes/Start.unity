  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>But du jeu</b>\r\nAtteignez le burger au bout de chaque niveau, le
    plus vite possible.\r\nLa partie compte deux niveaux. Le temps s'additionne d'un
    niveau \xE0 l'autre.\r\n<b>Les obstacles</b>\r\nLes murs, les obstacles qui tournent
    et les balles sont tous des obstacles.\r\nChaque obstacle touch\xE9 ajoute 2
    secondes de p\xE9nalit\xE9 \xE0 votre temps.\r\nUn obstacle touch\xE9 change
    de couleur : il ne compte qu'une seule fois.\r\nAttention aux zones pi\xE9g\xE9es
    : en y entrant, vous d\xE9clenchez leurs pi\xE8ges.\r\n<b>Le r\xE9sultat final</b>\r\nVotre
    r\xE9sultat est votre temps total, plus toutes vos p\xE9nalit\xE9s.\r\nPlus il
    est bas, meilleure est votre partie.\r\n<b>Les commandes</b>\r\nSe d\xE9placer
    : WASD ou les fl\xE8ches, joystick gauche de la manette\r\nMettre le jeu en pause
    : \xC9chap, bouton Start\r\n<b>Dans les menus</b>\r\nNaviguer : fl\xE8ches, joystick
    ou croix directionnelle\r\nValider : Entr\xE9e, bouton A\r\n<b>Conseils</b>\r\nObservez
    un obstacle qui tourne avant de passer.\r\nUn d\xE9tour sans collision est souvent
    plus rapide qu'une ligne droite avec p\xE9nalit\xE9s.\r\nLa pause arr\xEAte le
    chronom\xE8tre : profitez-en pour souffler.\r\nBonne course !"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fc2fbdaa287882a4daaa5d35c1ec0751, type: 2}
  m_sharedMaterial: {fileID: -2008952726485798003, guid: fc2fbdaa287882a4daaa5d35c1ec0751, type: 2}
